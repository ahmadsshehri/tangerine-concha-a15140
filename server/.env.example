# انسخ هذا الملف باسم .env داخل مجلد server وعدّل القيم حسب الحاجة

# المنفذ الذي يعمل عليه النظام (افتحه في جدار الحماية)
PORT=8080
HOST=0.0.0.0

# مكان قاعدة البيانات والنسخ الاحتياطية (يفضّل قرص عليه نسخ احتياطي من إدارة التقنية)
DATA_DIR=data
# BACKUP_DIR=D:\Backups\rehab
BACKUP_KEEP=30
BACKUP_HOUR=2

# مدة بقاء تسجيل الدخول بالأيام
SESSION_DAYS=30

# اجعلها true فقط إذا وُضع النظام خلف IIS أو nginx مع شهادة HTTPS
TRUST_PROXY=false
SECURE_COOKIES=false
