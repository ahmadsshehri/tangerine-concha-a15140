<?xml version="1.0" encoding="UTF-8"?>
<!-- اختياري: لنشر النظام عبر IIS (مثل باقي منصات الشبكة الداخلية) باسم/دومين داخلي
     يتطلب تثبيت URL Rewrite و Application Request Routing (ARR) وتفعيل Proxy في ARR -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="RehabSystem" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:8080/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
